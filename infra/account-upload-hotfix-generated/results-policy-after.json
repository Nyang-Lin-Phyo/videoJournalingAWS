{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:456157355328:table/reverie-journals-6ea829"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::videojournal-uploads-456157355328-6ea829/uploads/*",
        "arn:aws:s3:::videojournal-uploads-456157355328-6ea829/transcripts/*",
        "arn:aws:s3:::videojournal-uploads-456157355328-6ea829/results/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucketVersions",
      "Resource": "arn:aws:s3:::videojournal-uploads-456157355328-6ea829",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "uploads/*",
            "transcripts/*",
            "results/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminDeleteUser",
        "cognito-idp:AdminGetUser",
        "cognito-idp:ListUsers"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:456157355328:userpool/us-east-1_F92Oi9XtU"
    }
  ]
}